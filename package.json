{
  "name": "briandolph_test",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-ND-4.0",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss}\" \"tests/**/*.js\"",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "deploy": "gh-pages -d dist",
    "predeploy": "npm run build",
    "redeploy": "rd /s /q dist && npm run build && npm run deploy",
    "republish": "npm run build && gh-pages -d dist -r https://github.com/Brian-Qi/Brian-Qi.github.io.git",
    "readme": "git add README.md && git commit -m \"update README\" && git push"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "lxgw-wenkai-webfont": "^1.7.0",
    "vue": "^3.2.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/compiler-sfc": "^3.2.13",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.8",
    "sass": "^1.32.7",
    "sass-loader": "^12.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.11"
  }
}
