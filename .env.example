# 环境变量示例文件
# 复制此文件为 .env 并填写实际值

# Supabase 配置（从 Supabase 项目设置中获取）
VUE_APP_SUPABASE_URL=https://your-project.supabase.co
VUE_APP_SUPABASE_ANON_KEY=your-anon-key-here

# 管理员密码（生产环境应从更安全的方式获取）
VUE_APP_ADMIN_PASSWORD=your_secure_password_here

# 密钥
VUE_APP_SECRET_KEY=your_secret_key_here

# API 配置
VUE_APP_API_TIMEOUT=5000
VUE_APP_DEBUG_MODE=false

# 版本信息
VUE_APP_VERSION=1.0.0